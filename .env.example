# Required before production deployment: use the canonical public domain, without a trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com

# Optional but recommended for Organization / LocalBusiness schema.
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=

# Set only when a verified USD price feed or market-specific price list is connected.
NEXT_PUBLIC_USD_EXCHANGE_RATE=
